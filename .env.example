# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# auto = enabled only when ANTHROPIC_API_KEY is set; true/false to force
LLM_ENABLED=auto
LLM_MODEL=claude-opus-5-5
DEMO_TODAY=2026-09-18
# 1 = demo deployment: seeded user list, time travel, global reset, OTP shown on screen. Keep 0 elsewhere.
HISHAB_DEMO_MODE=1
# Comma-separated browser origins allowed by CORS (default: the Vite dev server)
HISHAB_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
